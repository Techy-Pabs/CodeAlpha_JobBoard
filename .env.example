# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Signs JWT access/refresh tokens. Must differ from SECRET_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Only used when DEBUG=False. Set to True when serving over HTTPS.
SECURE_COOKIES=False

# Postgres from docker-compose.yml (host port 5436)
POSTGRES_DB=job_board
POSTGRES_USER=job_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://job_user:change-me@localhost:5436/job_board

# Password for the accounts created by "python manage.py seed_demo".
DEMO_PASSWORD=change-me-demo-password

# Admin account created when the Docker container starts (all three or none).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
# True runs "seed_demo --force" every time the container starts.
SEED_DEMO_ON_START=False

# --- Resume storage. Leave all four empty to store resumes in media/. ---
# Set all four to store them in a private Cloudflare R2 bucket instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Email. Without EMAIL_HOST, emails are printed (DEBUG=True) or logged. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Job Board <noreply@jobboard.local>

# --- Production (Render) settings. The defaults below suit local use. ---
# Full origins (with https://) allowed to POST forms such as the admin login.
# On Render: CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=
# Redirect HTTP to HTTPS and send an HSTS header (one day). True on Render.
SECURE_SSL_REDIRECT=False
# Seconds to reuse a database connection (0 = reconnect every request).
DATABASE_CONN_MAX_AGE=60
# Proxies in front of the app, so throttling sees each client's real IP.
# Leave empty locally. See the Deployment section of the README for Render.
NUM_PROXIES=

# gunicorn (Docker image only). Render sets PORT itself; locally it's 8000.
# PORT=8000
# Worker processes. 2 fits Render's free plan (512 MB of RAM).
WEB_CONCURRENCY=2

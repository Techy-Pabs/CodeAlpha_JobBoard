# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# Signs JWT access/refresh tokens. Must differ from SECRET_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres from docker-compose.yml (host port 5436)
POSTGRES_DB=job_board
POSTGRES_USER=job_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://job_user:change-me@localhost:5436/job_board

# Seconds to reuse a database connection (0 = reconnect every request).
DATABASE_CONN_MAX_AGE=60
# Proxies in front of the app, so throttling sees each client's real IP.
# Leave empty locally.
NUM_PROXIES=
